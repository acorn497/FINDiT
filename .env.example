# FINDiT 환경 변수 예시
# docker-compose.yml 의 기본값과 같은 값이라 .env 없이도 바로 뜬다.
# 바꾸고 싶을 때만 복사해서 쓴다:  cp .env.example .env

# PostgreSQL
POSTGRES_USER=findit
POSTGRES_PASSWORD=findit
POSTGRES_DB=findit

# 웹 접속 포트 (http://localhost:8080)
WEB_PORT=8080

# 로그인 쿠키에 Secure 를 붙인다 — HTTPS 뒤에서 운영할 때만 true
COOKIE_SECURE=false

# 기동 때마다 시드(계정 3개·습득물 24건 등)를 넣는다. 이미 있으면 건너뛴다 (멱등)
SEED_ON_START=true
